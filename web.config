<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!--
      IIS's built-in WebDAV Publishing module intercepts specific verbs
      (OPTIONS, PROPFIND, PUT, DELETE, ...) BEFORE the FastCGI handler below
      ever runs, even though the handler's verb="*" looks like it should
      catch everything. If WebDAV is installed/enabled at the server level,
      an OPTIONS request to this app hits WebDAVModule first, which can
      surface as an opaque IIS 500 that never reaches Django/wfastcgi -
      matching "works with `manage.py runserver` locally, breaks only on
      the real IIS server" exactly.

      This removes WebDAV from THIS site's pipeline only. Safe to add even
      if WebDAV isn't installed (the <remove> is then a harmless no-op).
    -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
      <add
        name="Python FastCGI"
        path="*"
        verb="*"
        modules="FastCgiModule"
        scriptProcessor="D:\TT-Watch_tracker\env\Scripts\python.exe|D:\TT-Watch_tracker\env\Lib\site-packages\wfastcgi.py"
        resourceType="Unspecified"
        requireAccess="Script"
      />
    </handlers>

    <security>
      <requestFiltering
        allowDoubleEscaping="true"
        removeServerHeader="true"
      />
    </security>

    <httpProtocol>
      <customHeaders>

        <remove name="X-Powered-By" />

        <add
          name="Strict-Transport-Security"
          value="max-age=63072000; includeSubDomains"
        />

      </customHeaders>
    </httpProtocol>

    <rewrite>

      <!-- Added for Microsoft SSO -->
      <rules>
        <rule name="AddForwardedProto" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="None" />
        </rule>
      </rules>

      <outboundRules>

        <rule name="Remove X-Powered-By Header">
          <match
            serverVariable="RESPONSE_X-POWERED-BY"
            pattern=".*"
          />
          <action
            type="Rewrite"
            value=""
          />
        </rule>

      </outboundRules>

    </rewrite>

  </system.webServer>

  <appSettings>

    <add
      key="PYTHONPATH"
      value="D:\TT-Watch_tracker\watchcase_tracker"
    />

    <add
      key="WSGI_HANDLER"
      value="watchcase_tracker.wsgi.application"
    />

    <add
      key="DJANGO_SETTINGS_MODULE"
      value="watchcase_tracker.settings"
    />

  </appSettings>

</configuration>