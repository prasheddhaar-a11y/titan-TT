<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <handlers>
      <add
        name="Python FastCGI"
        path="*"
        verb="*"
        modules="FastCgiModule"
        scriptProcessor="D:\TT-Watch_tracker\env\Scripts\python.exe|D:\TT-Watch_tracker\env\Lib\site-packages\wfastcgi.py"
        resourceType="Unspecified"
        requireAccess="Script"
      />
    </handlers>

    <security>
      <requestFiltering
        allowDoubleEscaping="true"
        removeServerHeader="true"
      />
    </security>

    <httpProtocol>
      <customHeaders>

        <remove name="X-Powered-By" />

        <add
          name="Strict-Transport-Security"
          value="max-age=63072000; includeSubDomains"
        />

      </customHeaders>
    </httpProtocol>

    <rewrite>

      <!-- Added for Microsoft SSO -->
      <rules>
        <rule name="AddForwardedProto" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="None" />
        </rule>
      </rules>

      <outboundRules>

        <rule name="Remove X-Powered-By Header">
          <match
            serverVariable="RESPONSE_X-POWERED-BY"
            pattern=".*"
          />
          <action
            type="Rewrite"
            value=""
          />
        </rule>

      </outboundRules>

    </rewrite>
    <httpErrors errorMode="Custom">

        <remove statusCode="502" subStatusCode="3" />

        <error
            statusCode="502"
            subStatusCode="3"
            path="D:\TT-Watch_tracker\watchcase_tracker\error_pages\502.html"
            responseMode="File" />

    </httpErrors>

  </system.webServer>

  <appSettings>

    <add
      key="PYTHONPATH"
      value="D:\TT-Watch_tracker\watchcase_tracker"
    />

    <add
      key="WSGI_HANDLER"
      value="watchcase_tracker.wsgi.application"
    />

    <add
      key="DJANGO_SETTINGS_MODULE"
      value="watchcase_tracker.settings"
    />

  </appSettings>

</configuration>